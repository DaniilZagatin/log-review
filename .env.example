# Скопируйте в .env; существующий .env не перезаписывайте.
# OpenAI-совместимый endpoint, модель и ключ.
PKO_SCENARIO_BASE_URL=https://your-model-endpoint.example/v1
PKO_SCENARIO_MODEL=your-model-name
PKO_SCENARIO_API_KEY=
# Для mTLS задайте оба пути; иначе оставьте оба пустыми.
# PKO_SCENARIO_CLIENT_CERT=C:/certs/client.crt
# PKO_SCENARIO_CLIENT_KEY=C:/certs/client.key

# Окно контекста в токенах. Бюджет ответа подбирает агент с учётом окна.
# PKO_CONTEXT_WINDOW=128000
PKO_THINKING=false

# Один запуск = один trace. Локальный аудит работает независимо от Phoenix.
PKO_PHOENIX_ENABLED=false
PKO_PHOENIX_HOST=localhost
PKO_PHOENIX_PORT=6006
# PKO_PHOENIX_PROJECT=belka-scenario
# PKO_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_KEY=

# Для существующих установок поддерживаются прежние PKO_MATCHER_*,
# PKO_ASSEMBLER_* и GLM_* как резервные имена подключения.
# При смене endpoint старые ключи/сертификаты не переносятся автоматически.
