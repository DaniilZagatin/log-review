      "id": "invalid-details",
      "source": {
        "path": "example/invalid-details.py",
        "lines": [
          "def process(payment):",
          "    details = parser.extract(payment.text)",
          "    valid = valid_combination(details)",
          "    if valid:",
          "        return search(details)",
          "    if payment.kind == \"standard\":",
          "        return refuse(payment)",
          "    return manual(payment)"
        ]
      },
      "rubric": {
        "id": "invalid-details",
        "status": "provisional",
        "expected_operations": [
          {
            "id": "extract",
            "label": "Извлечь реквизиты",
            "evidence": {
              "path_suffix": "invalid-details.py",
              "line": 2
            }
          },
          {
            "id": "validate",
            "label": "Проверить комбинацию реквизитов",
            "evidence": {
              "path_suffix": "invalid-details.py",
              "line": 3
            }
          },
          {
            "id": "search",
            "label": "Найти договор",
            "evidence": {
              "path_suffix": "invalid-details.py",
              "line": 5
            }
          },
          {
            "id": "refuse",
            "label": "Отказать в обработке",
            "evidence": {
              "path_suffix": "invalid-details.py",
              "line": 7
            }
          },
          {
            "id": "manual",
            "label": "Передать на ручную обработку",
            "evidence": {
              "path_suffix": "invalid-details.py",
              "line": 8
            }
          }
        ],
        "expected_transitions": [
          {
            "source": "extract",
            "target": "validate"
          },
          {
            "source": "validate",
            "target": "search",
            "condition_pattern": "\\bвалидн"
          },
          {
            "source": "validate",
            "target": "refuse",
            "condition_pattern": "\\bневалидн.*\\bстандартн"
          },
          {
            "source": "validate",
            "target": "manual",
            "condition_pattern": "\\bневалидн.*\\bнестандартн"
          }
        ],
        "forbidden_transitions": [
          {
            "source": "extract",
            "target": "refuse"
          }
        ],
        "expected_properties": []
      }
